# Plantilla de configuracion. Es el unico archivo que tenes que completar.
#
# Copia este archivo a .env.local y completa los dos valores. Los sacas de
# supabase.com > tu proyecto > Project Settings > Data API / API Keys.
#
# Sin .env.local el panel no arranca: no hay base local ni claves por defecto,
# el proyecto habla siempre con tu Supabase en la nube.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# NO pongas aca la service_role key. El dashboard solo lee datos.
# La escritura la hace la skill /sync a traves del MCP de Supabase.
