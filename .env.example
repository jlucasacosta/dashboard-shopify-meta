# Plantilla para cuando pases a la nube.
#
# Para probar en tu maquina NO necesitas este archivo: .env.development ya trae
# los valores de Supabase local y el proyecto arranca solo.
#
# Cuando tengas tu proyecto en supabase.com, copia este archivo a .env.local y
# completa los valores. Los sacas de supabase.com > tu proyecto >
# Project Settings > Data API / API Keys. .env.local le gana a .env.development.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# NO pongas aca la service_role key. El dashboard solo lee datos.
# La escritura la hace la skill /sync a traves del MCP de Supabase.
