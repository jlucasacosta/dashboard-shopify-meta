# Plantilla de configuracion. Copiala a .env.local y completala.
#
# .env.local sirve para dos cosas:
#   1. Correr el panel en tu computadora (npm run dev).
#   2. Correr los scripts (webhooks:registrar, usuario:crear, nube:verificar).
#
# Para que el panel funcione DESPLEGADO, los mismos valores tienen que estar en
# Vercel. Cuando termines de completar este archivo:
#
#     npm run env:subir
#
# los sube todos de una y te dice cuales quedaron. Despues hay que volver a
# desplegar: Vercel no aplica variables a un deploy ya hecho.


# ============================================================================
# PUBLICO — viaja al navegador
# ============================================================================
# Cualquiera que abra el panel puede leer estos dos valores. Esta bien: la anon
# key sola no permite escribir nada, las policies de RLS lo impiden.
#
# supabase.com > tu proyecto > Project Settings > Data API / API Keys

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Los scripts de la carpeta scripts/ leen estos dos nombres, sin el prefijo.
# Son los MISMOS valores de arriba, repetidos para no tener que pasarlos a mano
# en cada comando. Estos NO se suben a Vercel.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# ============================================================================
# PRIVADO — solo el servidor
# ============================================================================
# NINGUNA de estas puede llevar el prefijo NEXT_PUBLIC_. Si se lo ponés, Next
# las mete en el bundle del navegador y quedan publicas para siempre.

# --- Supabase -------------------------------------------------------------
# La clave que le permite al sync escribir. Bypassa RLS: tratala como una
# contraseña de administrador.
# supabase.com > Project Settings > API Keys > service_role
SUPABASE_SERVICE_KEY=

# --- Shopify --------------------------------------------------------------
# La app se crea en shopify.dev/dashboard (el flujo viejo de "Desarrollar apps"
# desde el admin ya no existe para tiendas nuevas). Scopes que necesita:
#   read_reports  (para las consultas de ShopifyQL)
#   read_orders   (para el webhook que avisa que algo cambio)
# NO hace falta read_all_orders: el limite de 60 dias es del objeto Order, y
# este panel lee por ShopifyQL, que no lo tiene.
SHOPIFY_SHOP_DOMAIN=tu-tienda.myshopify.com
SHOPIFY_ADMIN_TOKEN=
# Client secret de la app. Con esto se verifica que el webhook venga de Shopify.
SHOPIFY_API_SECRET=

# --- Meta Ads (opcional) --------------------------------------------------
# Sin esto el panel muestra las ventas pero no CAC, ROAS, MER ni contribucion.
# Usa un token de usuario del sistema (Business Manager), no el del Graph API
# Explorer: ese ultimo dura dos horas. Permiso necesario: ads_read.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# --- Mercado Libre (opcional) ---------------------------------------------
# Cada instalacion necesita SU PROPIA app de Mercado Libre: el redirect_uri
# tiene que coincidir exacto con la URL de tu panel, y no admite comodines.
# En el devcenter de MeLi, poner como redirect URI:
#   https://tu-panel.vercel.app/api/meli/callback
MELI_APP_ID=
MELI_SECRET_KEY=
# Host de autorizacion segun tu pais: .com.uy, .com.ar, .com.br, .com.mx...
MELI_AUTH_HOST=https://auth.mercadolibre.com.uy

# --- Sincronizacion -------------------------------------------------------
# URL publica del panel, sin barra al final. Usa el alias corto que te da
# Vercel (proyecto.vercel.app), no el largo con tu nombre de usuario: este
# valor termina en los webhooks de Shopify y en el redirect de Mercado Libre,
# y si despues cambia hay que rehacer los dos.
APP_URL=https://tu-panel.vercel.app

# Secreto compartido con pg_cron. Genera uno largo al azar:
#   openssl rand -hex 32
# El MISMO valor va en la base:
#   insert into config_servidor (key, value) values
#     ('app_url', 'https://tu-panel.vercel.app'),
#     ('cron_secret', 'el-mismo-valor-de-aca');
#   select programar_sync();
CRON_SECRET=

# Moneda en la que el panel muestra todo. El resto se convierte a esta.
STORE_CURRENCY=UYU


# ============================================================================
# AJUSTES (opcionales, casi nunca se tocan)
# ============================================================================
# Cuantos dias trae el backfill por vuelta, y hasta cuanto atras llega.
# Si el backfill se corta por tiempo, bajar el primero.
# DIAS_POR_LOTE=90
# DIAS_PRIMERA_CORRIDA=365
